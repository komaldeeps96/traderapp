{
  "name": "traderapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time stock charting terminal — FastAPI backend, React + lightweight-charts frontend",
  "workspaces": [
    "frontend",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend && npm run typecheck --workspace e2e",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:unit": "npm run test --workspace frontend",
    "test:e2e": "npm run test --workspace e2e",
    "test:e2e:ci": "npm run test:ci --workspace e2e",
    "test:e2e:ui": "npm run test:ui --workspace e2e",
    "screenshots": "npm run screenshots --workspace e2e",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  }
}
